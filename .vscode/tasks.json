{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CADinvent: development server",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "CADinvent: portable app in Firefox (Windows)",
      "type": "process",
      "command": "${workspaceFolder}/release/cadinvent-windows-amd64.exe",
      "args": ["-browser", "firefox"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "CADinvent: tests",
      "type": "shell",
      "command": "pnpm test",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
